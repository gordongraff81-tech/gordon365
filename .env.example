# ── Gordon365 Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local for local development.
# In Vercel: add via Project > Settings > Environment Variables
# In Cloudflare: add via Workers & Pages > your project > Settings > Variables

# ── Application ──
NEXT_PUBLIC_BASE_URL=https://gordon365.com
NEXT_PUBLIC_URL=https://gordon365.com

# ── Stripe ──
# Secret key from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# Product price IDs from Stripe Dashboard > Products > Pricing
NEXT_PUBLIC_STRIPE_PRICE_ID_HARDENING=price_hardening_id_here
NEXT_PUBLIC_STRIPE_PRICE_ID_MFA=price_mfa_id_here
NEXT_PUBLIC_STRIPE_PRICE_ID_INTUNE=price_intune_id_here

# ── Zoho Mail Integration ──
# OAuth access token from https://api-console.zoho.eu
# Required scope: ZohoMail.messages.CREATE
ZOHO_TOKEN=your_zoho_oauth_token_here

# Your Zoho Mail account ID (found in API console or mail settings URL)
ZOHO_ACCOUNT_ID=your_zoho_account_id_here

# SMTP user (default: info@gordon365.com)
SMTP_USER=info@gordon365.com

# Email address to receive form notifications
NOTIFY_EMAIL=gordon@gordon365.com

# ── Upstash Redis (Rate Limiting) ──
# Get credentials from https://upstash.com
# Optional: rate limiting will be disabled if not configured
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# ── Optional: Analytics ──
# Plausible (EU-hosted, GDPR-compliant, no cookie consent required)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=gordon365.com

# Google Analytics 4 (requires cookie consent banner)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Optional: CRM / Calendly ──
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/gordon365/strategy-call
